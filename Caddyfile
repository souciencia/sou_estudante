# Caddyfile de produção do SoU_Estudante.
#
# Antes de subir:
#   1. Troque o host abaixo pelo domínio/subdomínio real (registro A apontando
#      para o IP da VM). O Caddy emite o certificado TLS automaticamente, desde
#      que as portas 80 e 443 estejam liberadas.
#   2. Gere o hash da senha do basic auth e substitua HASH_AQUI:
#        podman run --rm -it docker.io/library/caddy:2 caddy hash-password
#
# Sem domínio: use <IP-com-hífens>.sslip.io ou um subdomínio DuckDNS.
# Evite http://<IP> puro, pois a senha do basic auth trafegaria em claro.

http://172.22.29.229.nip.io/ {
	basic_auth {
		testador HASH_AQUI
	}
	reverse_proxy se_front:3000
}
