# Modelo de variáveis de ambiente. O ./setup.sh copia este arquivo para .env.
# Variáveis marcadas como "preenchida pelo setup.sh" não devem ser editadas à mão.

# --- Elasticsearch ---
ESNODE01_NAME=se_es01
ELASTICSEARCH_URL=http://se_es01:9200
ELASTICSEARCH_USERNAME=elastic
# Em branco de propósito: o setup.sh pede a senha (ou use --password).
ELASTIC_PASSWORD=

# API keys: preenchidas pelo setup.sh. Não use comentário na mesma linha:
# o setup.sh lê o valor inteiro depois do "=".
# Somente leitura, usada pela API (ES_APIKEY):
ELASTICSEARCH_APIKEY=
# Leitura/escrita, usada só pela ingestão (ES_INGEST_APIKEY):
ELASTICSEARCH_BULK_APIKEY=

# --- Índices ---
CURSOS_INDEX_NAME=cursos
CURSOS_DICT_INDEX_NAME=dicionario-cursos
IES_INDEX_NAME=ies
IES_DICT_INDEX_NAME=dicionario-ies

# --- Ingestão (caminhos dentro do container se_bulk; ./data é montado em /data) ---
CURSOS_JSON_FILE_PATH=/data/dados_cursos.json
IES_JSON_FILE_PATH=/data/dados_ies.json

# --- Front / API ---
# URL da API vista pelo servidor Next.js (rewrite de /api). Resolvida em build.
API_URL=http://se_api:8080

# --- Produção (docker-compose.prod.yml) ---
# Heap do Elasticsearch (JVM). Ajuste conforme a RAM da VM: até metade da
# memória, deixando folga para o SO e o page cache. Fixar o heap evita que a
# JVM estoure o limite da máquina.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Tag das imagens sou_estudante/{api,front,seed}. Padrão: latest.
# IMAGE_TAG=latest
